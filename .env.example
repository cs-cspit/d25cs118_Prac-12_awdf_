PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
# Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
# Set to false to measure the uncached baseline
CACHE_ENABLED=true
# Seconds a cached GET response stays valid
CACHE_TTL=60
# Practical 10 - background notifications
# async (default): task-created handled by the EventEmitter listener after responding
# sync: notification runs inside the route (comparison only)
NOTIFY_MODE=async
# Simulated slow notification work in ms
NOTIFY_DELAY_MS=2000
